#!/bin/bash

set -e

show_help() {
	cat << EOF
usage: $(basename "$0") [-h] [-t | -r <issue-or-message-id>]

options:
	-h           Prints this help message
	-t           Opens a new template in a disposable editor session
	-r <target>  Opens a reply template for <target>

note:
	replying will not work yet because mailing lists are being setup
EOF
}

make_template() {
	TMP_TEMPLATE=$(mktemp /tmp/email_issue_XXXXXX)
	cat << 'EOF' > "$TMP_TEMPLATE"
# Lines beginning with hashtags (like this one) are generated by the template.
# They are not included in the issue.
# Leave a newline at the bottom
#
# Valid Types:
#   BUG      - Code errors, flaws, failures, or crashes.
#   FEATURE  - Proposals or requests for new pipeline functionality.
#   DOCS     - Technical manuals, code comments, or web updates.
#   REFACTOR - Structural/readability cleanups (no behavior changes).
#   PATCH    - Concrete code submissions fulfilling an issue request.
#
# Valid Levels:
#   LOW      - Minor cosmetic issues or typos; zero threat to stability.
#   MEDIUM   - Minor flaws; system works but specific feature is broken.
#   HIGH     - Severe flaws; major workflow failures or loop crashes.
#   FATAL    - Completely unusable; unable to boot or compile.
#   EXPLOIT  - Security vulnerabilities (overflows, memory leaks, etc.)
#              This must be used for anything that could be used harmfully.
#              Successful reporting will result in your name in ACKNOWLEDGMENTS.
#              More details are in SECURITY.
#
# NOTE: Spamming useless issues or useless information will result in a block

[TYPE/LEVEL] Issue title (doe)

Describe the issue with as much details and related specs about the machine that ran it (if they apply)

@@END-OF-ISSUE@@
EOF

	cp "$TMP_TEMPLATE" "$TMP_TEMPLATE.orig"
	nano "$TMP_TEMPLATE"

	if diff -q "$TMP_TEMPLATE" "$TMP_TEMPLATE.orig" >/dev/null; then
		echo "error: no changes made. aborting..." >&2
		rm -f "$TMP_TEMPLATE" "$TMP_TEMPLATE.orig"
		exit 1
	fi

	rm "$TMP_TEMPLATE.orig" 
}

case 
